[Unit]
Description=Pocket Vault — passwords for the Bitwarden apps
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-vault
Group=pocket-vault
ExecStart=/usr/local/bin/pocket-vault
Environment=DATA_DIR=/var/lib/pocket-vault
Environment=PORT=8080
Environment=BASE_URL=https://vault.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-vault
PrivateTmp=true

[Install]
WantedBy=multi-user.target
